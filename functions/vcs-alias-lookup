# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

if (( # < 2 )); then
  print -u2 "usage: ${0} <module home> <alias prefix> [pattern...]"
  return 2
fi

local -r vmodule_home=${1} vprefix=${2}
shift 2
local -r vpattern=${(j:.*:)@}

local vline valias vsection
local -a vrows vsections
local -i vinsection=0
# read one-line documentations from the Aliases section of README.md, grouped
# under the same section headers used there (and mirrored by the comments
# above each block of aliases in init.zsh)
while IFS= read -r vline; do
  if [[ ${vline} == 'Aliases' ]]; then
    vinsection=1
    continue
  elif (( vinsection )) && [[ ${vline} == 'Settings' ]]; then
    vinsection=0
    continue
  fi
  (( vinsection )) || continue
  if [[ ${vline} =~ '^### (.*)$' ]]; then
    vsection=${match[1]}
    continue
  fi
  if [[ ${vline} =~ '^ *\* `([^`]*)` (.*)$' ]]; then
    valias=${vprefix}${match[1]}
    vline=${valias}$'\t'${aliases[${valias}]}$'\t'${match[2]}
    # a pattern matching the section name (e.g. 'branch') pulls in the
    # whole section, not just the lines that happen to match it too
    if [[ -z ${vpattern} || ${vline} =~ ${vpattern} || ${(L)vsection} =~ ${(L)vpattern} ]]; then
      vrows+=(${vline})
      vsections+=(${vsection})
    fi
  fi
done < ${vmodule_home}/README.md

# align columns first; column -t drops blank lines, so interleave the
# section headers and blank line separators afterwards, straight to stdout
local -a vformatted
vformatted=(${(f)"$(command column -s $'\t' -t <<<${(F)vrows})"})

local vlastsection=
local -i vi
for (( vi = 1; vi <= ${#vrows}; vi++ )); do
  if [[ ${vsections[vi]} != ${vlastsection} ]]; then
    (( vi == 1 )) || print -R ''
    print -R "${vsections[vi]}:"
    vlastsection=${vsections[vi]}
  fi
  print -R ${vformatted[vi]}
done
