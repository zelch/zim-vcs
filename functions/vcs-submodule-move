# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

local vcs_cmd=${1:?}
shift

local vcs_root
vcs_root=$(vcs-root ${vcs_cmd}) || return 1

if (( # != 2 )); then
  print -u2 "usage: ${0} <cmd> <source> <destination>"
  return 2
fi

local -r src=${1} dst=${2}
local -r url=$(command ${vcs_cmd} -C ${vcs_root} config --file .gitmodules --get submodule.${src}.url)
if [[ -z ${url} ]]; then
  print -u2 "${0}: submodule not found: ${src}"
  return 1
fi

command mkdir -p ${dst:h} && \
    vcs-submodule-remove ${vcs_cmd} ${src} && \
    command ${vcs_cmd} -C ${vcs_root} submodule add ${url} ${dst}
