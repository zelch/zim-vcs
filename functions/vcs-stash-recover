# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

local vcs_cmd=${1:?}
shift

command ${vcs_cmd} rev-parse --is-inside-work-tree >/dev/null || return 1

if (( ! # )); then
  print -u2 "usage: ${0} <cmd> <commit...>"
  return 2
fi

local commit
for commit in "${@}"; do
  command ${vcs_cmd} update-ref \
    -m "$(command ${vcs_cmd} log -1 --pretty='format:%s' ${commit})" refs/stash ${commit}
done
