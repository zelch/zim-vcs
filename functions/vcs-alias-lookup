# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

if (( # < 2 )); then
  print -u2 "usage: ${0} <module home> <alias prefix> [pattern...]"
  return 2
fi

local -r vmodule_home=${1} vprefix=${2}
shift 2
local -r vpattern=${(j:.*:)@}

local vline valias vsection vlastsection=
local -i vinsection=0 vfirst=1
# read one-line documentations from the Aliases section of README.md, grouped
# under the same section headers used there (and mirrored by the comments
# above each block of aliases in init.zsh)
while IFS= read -r vline; do
  if [[ ${vline} == 'Aliases' ]]; then
    vinsection=1
    continue
  elif (( vinsection )) && [[ ${vline} == 'Settings' ]]; then
    vinsection=0
    continue
  fi
  (( vinsection )) || continue
  if [[ ${vline} =~ '^### (.*)$' ]]; then
    vsection=${match[1]}
    continue
  fi
  if [[ ${vline} =~ '^ *\* `([^`]*)` (.*)$' ]]; then
    valias=${vprefix}${match[1]}
    vline=${valias}$'\t'${aliases[${valias}]}$'\t'${match[2]}
    if [[ -z ${vpattern} || ${vline} =~ ${vpattern} ]]; then
      if [[ ${vsection} != ${vlastsection} ]]; then
        (( vfirst )) || print -R ''
        print -R "${vsection}:"
        vlastsection=${vsection}
        vfirst=0
      fi
      print -R ${vline}
    fi
  fi
done < ${vmodule_home}/README.md | command column -s $'\t' -t
