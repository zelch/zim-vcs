# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

command yadm rev-parse --is-inside-work-tree >/dev/null || return 1

if (( ! # )); then
  print -u2 "usage: ${0} <commit...>"
  return 2
fi

local commit
for commit in "${@}"; do
  command yadm update-ref \
    -m "$(command yadm log -1 --pretty='format:%s' ${commit})" refs/stash ${commit}
done
