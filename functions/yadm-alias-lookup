# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

if (( # < 1 )); then
  print -u2 "usage: ${0} <path to yadm module> [pattern...]"
  return 2
fi
local yprefix
zstyle -s ':zim:yadm' aliases-prefix 'yprefix' || yprefix=Y

local yline yalias
local -r ymodule_home=${1}
shift
local -r ypattern=${(j:.*:)@}
# read one-line documentations from README.md
while IFS= read -r yline; do
  if [[ ${yline} =~ '^ *\* `Y([^`]*)` (.*)$' ]]; then
    yalias=${yprefix}${match[1]}
    yline=${yalias}$'\t'${aliases[${yalias}]}$'\t'${match[2]}
    if [[ -z ${ypattern} || ${yline} =~ ${ypattern} ]] print -R ${yline}
  fi
done < ${ymodule_home}/README.md | command column -s $'\t' -t
