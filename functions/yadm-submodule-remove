# vim:et sts=2 sw=2 ft=zsh
builtin emulate -L zsh

local yadm_root yadm_dir
yadm_root=$(yadm-root) || return 1
yadm_dir=$(yadm-dir) || return 1

if (( # != 1 )); then
  print -u2 "usage: ${0} <path>"
  return 2
fi

local -r src=${1}
if ! command yadm -C ${yadm_root} config --file .yadmmodules --get submodule.${src}.path &>/dev/null; then
  print -u2 "${0}: submodule not found: ${src}"
  return 1
fi

command yadm -C ${yadm_root} config --file ${yadm_dir}/config --remove-section submodule.${src} &>/dev/null
command yadm -C ${yadm_root} config --file .yadmmodules --remove-section submodule.${src} &>/dev/null
command yadm -C ${yadm_root} add .yadmmodules
command yadm -C ${yadm_root} rm --cached ${src} &>/dev/null
command rm -rf ${yadm_root}/${src}
command rm -rf ${yadm_dir}/modules/${src}
return 0
